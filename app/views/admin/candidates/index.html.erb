<div class="border-t-2 border-sky-400"></div>

<header class="border-b border-white/5 bg-black/80 backdrop-blur-sm sticky top-0 z-30">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-bold text-lg tracking-tight">Iterato</a>
    <div class="flex items-center gap-3">
      <span class="text-xs text-white/30 border border-white/10 rounded-full px-3 py-1">Back-office Candidat</span>
      <%= button_to "Déconnexion", session_path, method: :delete, class: "text-xs text-white/40 hover:text-[#FB923C] transition-colors bg-transparent border-none cursor-pointer" %>
    </div>
  </div>
</header>

<main class="max-w-6xl mx-auto px-6 py-10"
      data-controller="card-filter delete-confirm">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold tracking-tight">Candidats <span class="text-white/40 text-lg font-normal">(<%= @candidates.length %>)</span></h1>
    <div class="flex gap-2 text-xs">
      <button data-action="card-filter#filter" data-card-filter-type-param="all"
              class="border border-[#FB923C]/30 text-[#FB923C] rounded-lg px-3 py-1.5 font-medium transition-colors"
              data-card-filter-target="filter">Tous</button>
      <button data-action="card-filter#filter" data-card-filter-type-param="DevOps Engineer"
              class="border border-white/20 text-white/50 rounded-lg px-3 py-1.5 transition-colors hover:text-white"
              data-card-filter-target="filter">DevOps</button>
      <button data-action="card-filter#filter" data-card-filter-type-param="SRE"
              class="border border-white/20 text-white/50 rounded-lg px-3 py-1.5 transition-colors hover:text-white"
              data-card-filter-target="filter">SRE</button>
      <button data-action="card-filter#filter" data-card-filter-type-param="Platform Engineer"
              class="border border-white/20 text-white/50 rounded-lg px-3 py-1.5 transition-colors hover:text-white"
              data-card-filter-target="filter">Platform</button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @candidates.each do |c| %>
      <div class="border border-white/10 rounded-xl p-5 hover:border-white/20 hover:bg-white/[0.02] transition-all group"
           data-card-filter-target="card"
           data-card-filter-profile="<%= c.profile_type %>">
        <div class="flex items-start justify-between mb-4">
          <div class="w-10 h-10 rounded-full bg-[#FB923C]/20 text-[#FB923C] flex items-center justify-center font-bold text-sm">
            <%= c.first_name[0] %><%= c.last_name[0] %>
          </div>
          <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
            <button type="button"
                    data-action="delete-confirm#open"
                    data-delete-candidate-id="<%= c.id %>"
                    data-delete-candidate-name="<%= c.first_name %> <%= c.last_name %>"
                    class="text-white/20 hover:text-red-400 transition-colors text-xs">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
            <a href="<%= c.linkedin_url %>" target="_blank" class="text-white/20 hover:text-[#FB923C] transition-colors text-xs">LinkedIn →</a>
          </div>
        </div>

        <h3 class="font-semibold text-base mb-0.5"><%= c.first_name %> <%= c.last_name %></h3>
        <p class="text-white/40 text-sm mb-3"><%= c.email %></p>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs bg-[#FB923C]/10 text-[#FB923C] px-2 py-0.5 rounded-full"><%= c.profile_type %></span>
          <% badge_class = case c.experience_level
            when "Junior" then "border border-white/20 text-white/60"
            when "Confirmé" then "text-white/60 border border-white/20"
            when "Senior" then "text-white border border-white/30"
            when "Lead" then "bg-white text-black font-semibold border border-white"
            else "border border-white/20 text-white/60"
          end %>
          <span class="text-xs px-2 py-0.5 rounded-full <%= badge_class %>"><%= c.experience_level %></span>
          <% if c.entry_point == "job_application" %>
            <span class="text-xs bg-sky-500/10 text-sky-400 px-2 py-0.5 rounded-full">Offre d'emploi</span>
          <% else %>
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full">Communauté</span>
          <% end %>
        </div>

        <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs">
          <span class="text-white/30">Reçu le <%= c.created_at&.strftime("%d/%m/%Y") %></span>
          <a href="<%= admin_candidate_download_cv_path(c.id) %>" class="text-white/40 hover:text-[#FB923C] transition-colors">Télécharger CV</a>
        </div>
      </div>
    <% end %>
  </div>

  <div id="delete-modal"
       data-delete-confirm-target="modal"
       class="fixed inset-0 z-50 flex items-center justify-center p-6 hidden">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" data-action="click->delete-confirm#close"></div>
    <div class="relative bg-zinc-900 border border-white/10 rounded-2xl p-8 max-w-md w-full">
      <button data-action="click->delete-confirm#close" class="absolute top-4 right-4 text-white/40 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="text-xl font-bold mb-2 text-white">Supprimer ce candidat ?</h3>
      <p class="text-white/50 mb-6">Cette action est irréversible. Le candidat sera masqué du dashboard.</p>
      <form data-delete-confirm-target="form" method="POST" class="flex gap-3">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="button" data-action="click->delete-confirm#close" class="flex-1 py-3 rounded-lg border border-white/10 text-white/60 hover:text-white hover:border-white/20 transition-colors">Annuler</button>
        <button type="submit" class="flex-1 py-3 rounded-lg bg-red-500 hover:bg-red-600 text-white font-semibold transition-colors">Confirmer</button>
      </form>
    </div>
  </div>
</main>
